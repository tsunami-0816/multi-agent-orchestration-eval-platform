# 多智能体编排与模型评测一体化平台 - 环境变量示例
# 复制为 .env 后填入实际值，环境变量优先级高于 config.yaml

# === 应用 ===
APP_DEBUG=false
# API 鉴权密钥（可选，未设置则不鉴权）
APP_API_KEY=

# === 数据库 ===
APP_DATABASE_URL=sqlite+aiosqlite:///data/db/app.db

# === Redis ===
APP_REDIS_URL=redis://localhost:6379/0

# === Celery ===
APP_CELERY_BROKER_URL=redis://localhost:6379/0
APP_CELERY_RESULT_BACKEND=redis://localhost:6379/1
APP_CELERY_WORKER_CONCURRENCY=4

# === LLM ===
# 提供商：deepseek / qwen / ollama / mock
APP_LLM_PROVIDER=mock
# LLM API 密钥（deepseek/qwen 必填，mock/ollama 可留空）
APP_LLM_API_KEY=
# 模型名称
APP_LLM_MODEL=deepseek-chat
# API 基础 URL
APP_LLM_BASE_URL=https://api.deepseek.com/v1

# === 预算控制（P1-9）===
APP_BUDGET_DAILY_LIMIT=200.0
APP_BUDGET_WARNING_THRESHOLD=180.0

# === 日志 ===
# Docker 环境下保持 false（P2-10），非容器化部署可设为 true
APP_LOG_TO_FILE=false
APP_LOG_LEVEL=INFO

# === Agent ===
APP_AGENT_MAX_ROUNDS=5
APP_AGENT_MAX_TOOL_CALLS=5
